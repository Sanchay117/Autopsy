# Copy to .env.local. Everything is optional: with nothing set, Autopsy runs on
# an offline mock of the Airwallex sandbox, a mock Metal rail and a rules reader.

# Airwallex sandbox. Keys come from the sandbox web app (https://www.sandbox.airwallex.com/app/), Account > Developer > API keys.
# Run `pnpm setup:sandbox` once, then set AWX_MODE=sandbox.
AWX_MODE=mock
AWX_CLIENT_ID=
AWX_API_KEY=
# Tested with 2025-02-14. Older account defaults lose the failure reason on a returned payout.
AWX_API_VERSION=2025-02-14

# Metal: off, mock (default) or testnet. Testnet needs the metal-agent CLI on PATH.
METAL_MODE=mock
METAL_CREDENTIAL=
METAL_RPC_URL=

# Claude reads supplier emails into a fixed schema and words the explanations.
# Without a key the same steps run on rules.
ANTHROPIC_API_KEY=
